# JWT
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXP_HOURS=48

# OTP TTL (giây)
OTP_TTL_SECONDS=300
OTP_LENGTH=6

# Gmail SMTP (dùng App Password của Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your_email@gmail.com
# Bật để bắt buộc gửi OTP qua email thật (không in OTP ra console)
SMTP_REQUIRED=1

# Password hashing
PBKDF2_ITERS=200000

# Seed 1 initial ADMIN account (only used when no ADMIN exists)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=ChangeMe_admin_password
INITIAL_ADMIN_EMAIL=admin@example.com

